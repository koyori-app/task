{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "ignorePresets": [":prHourlyLimit2"],
  // "baseBranches": ["develop", "master"],
  "schedule": ["before 9am on monday"],
  "timezone": "Asia/Tokyo",
  // "dependencyDashboard": false,
  "automerge": false,
  "prHourlyLimit": 100,
  "prConcurrentLimit": 100,
  "branchConcurrentLimit": 100,
  // "labels": ["type/Dependencies📦"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchManagers": ["github-actions", "gitlabci", "gitlabci-include"],
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "digest"],
      // Apply the same cooldown to CI action updates before automerge.
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["cargo"],
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "digest"],
      // Keep Rust crate automerge on the same cooldown as npm/pnpm.
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["npm"],
      // "addLabels": ["topic/JavaScript🧶"]
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "digest"],
      // Align Renovate automerge with pnpm v11's default supply-chain delay.
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["docker-compose", "dockerfile"],
      // "addLabels": ["topic/Docker⚓"]
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "digest"],
      // Apply the same cooldown to container image updates before automerge.
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["npm"],
      "matchPackagePatterns": ["scalar"],
      "groupName": "scalar"
    },
    {
      "matchManagers": ["npm"],
      "matchPackagePatterns": ["regle"],
      "groupName": "regle"
    },
    {
      "matchManagers": ["npm"],
      "matchPackagePatterns": ["vueuse"],
      "groupName": "vueuse"
    },
    {
      "matchManagers": ["npm"],
      "matchPackagePatterns": ["vue-macros"],
      "groupName": "vue-macros"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["vite", "vite-plus", "vitest"],
      // vite-plus bundles a pinned vitest; @vitest/* providers (coverage-v8,
      // browser-playwright, ...) must match that exact version, so group them
      // all into one PR to avoid a version-skew split (see #248 / #293).
      "matchPackagePatterns": ["^@voidzero-dev/", "^@vitest/"],
      "groupName": "vite-plus"
    },
    {
      // mermaid は 11.16.1 で凍結する。
      // 何のために止めたか: mermaid 11.17.0 で C4 の renderer が unified へ
      // 移り、C4 図の見た目が変わる（上流 issue #7849）。11.17.2 の描画も
      // 12.0.0 と同一であり、上げれば同じ退行を踏む。
      // 何が起きたら解くか: C4 以外の図種の改善が、C4 の見た目の退行を
      // 上回ったとき。解くにはこの rule を消せば renovate は再び上げ始める。
      "matchManagers": ["npm"],
      "matchPackageNames": ["mermaid"],
      "enabled": false
    }
  ]
}
