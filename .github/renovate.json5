{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "ignorePresets": [":prHourlyLimit2"],
  // "baseBranches": ["develop", "master"],
  "schedule": ["before 9am on monday"],
  "timezone": "Asia/Tokyo",
  // "dependencyDashboard": false,
  "automerge": false,
  // 枝を焼き直すのは衝突した時だけにする。
  // 何のために: 既定の auto は automerge を持つ規則に behind-base-branch を
  // 当てる。main が一つ進むたびに開いておる枝が全て焼き直され、CI が積もって
  // 捌けなくなった。
  // automerge は止まらぬ: main に枝の保護も ruleset も無く、最新であることを
  // 強いておらぬ。
  // 二つの更新が互いに試されぬまま続けて入りうることは承知の上である。
  // main への push で backend-test や e2e などが走り、壊れればそこで露見する。
  // 露見したら、その時に直す。焼き直しを増やして先回りで防ぐことはせぬ。
  "rebaseWhen": "conflicted",
  // この札を貼った PR だけは、main より遅れるたびに焼き直す。
  // merge する前に最新の main で試し直したい PR に貼る。外しても害は無い。
  "keepUpdatedLabel": "dependencies/keep-updated",
  "prHourlyLimit": 100,
  "prConcurrentLimit": 100,
  "branchConcurrentLimit": 100,
  // "labels": ["type/Dependencies📦"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchManagers": ["github-actions", "gitlabci", "gitlabci-include"],
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "digest"],
      // Apply the same cooldown to CI action updates before automerge.
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["cargo"],
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "digest"],
      // Keep Rust crate automerge on the same cooldown as npm/pnpm.
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["npm"],
      // "addLabels": ["topic/JavaScript🧶"]
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "digest"],
      // Align Renovate automerge with pnpm v11's default supply-chain delay.
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["docker-compose", "dockerfile"],
      // "addLabels": ["topic/Docker⚓"]
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "digest"],
      // Apply the same cooldown to container image updates before automerge.
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["npm"],
      "matchPackagePatterns": ["scalar"],
      "groupName": "scalar"
    },
    {
      "matchManagers": ["npm"],
      "matchPackagePatterns": ["regle"],
      "groupName": "regle"
    },
    {
      "matchManagers": ["npm"],
      "matchPackagePatterns": ["vueuse"],
      "groupName": "vueuse"
    },
    {
      "matchManagers": ["npm"],
      "matchPackagePatterns": ["vue-macros"],
      "groupName": "vue-macros"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["vite", "vite-plus", "vitest"],
      // vite-plus bundles a pinned vitest; @vitest/* providers (coverage-v8,
      // browser-playwright, ...) must match that exact version, so group them
      // all into one PR to avoid a version-skew split (see #248 / #293).
      "matchPackagePatterns": ["^@voidzero-dev/", "^@vitest/"],
      "groupName": "vite-plus"
    },
    {
      // @codemirror/ の package は一つの PR で揃えて上げる。
      // 何のために束ねたか: どの package も @codemirror/state の EditorState や
      // Extension を受け渡す。版がずれると state が二つ入り、同じ型が別の実体
      // になって typecheck が落ちる。実行時も instanceof が壊れ、編集器が描け
      // なくなる（#694）。別々の PR で上げれば、途中の版で必ずずれる。
      // なぜ前方一致か: どの package も state を引くゆえ、後から足した package
      // も同じ群れに入る。名指しにすると、足した時の書き足しを忘れて漏れる。
      // renovate の既定（group:recommended の group:codemirror）も同じく束ねる。
      // ここに書くのは、束ねる理由を残し、既定が変わっても外れぬためである。
      // 束ねても、lock の推移の解決に古い state が残ることは防げぬ（#694 で
      // 起きた）。二重取りが出たら lock を取り直す。
      // 何が起きたら解くか: 解かぬ。分けた方が細かく見られると思っても分けるな。
      "matchManagers": ["npm"],
      "matchPackagePatterns": ["^@codemirror/"],
      "groupName": "codemirror"
    }
  ]
}
