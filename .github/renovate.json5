{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  ignorePresets: [
    ':prHourlyLimit2',
  ],
  schedule: [
    'after 5am and before 9am on monday',
  ],
  timezone: 'Asia/Tokyo',
  automerge: false,
  rebaseWhen: 'conflicted',
  keepUpdatedLabel: 'dependencies/keep-updated',
  prHourlyLimit: 100,
  prConcurrentLimit: 100,
  branchConcurrentLimit: 100,
  labels: [
    'dependencies',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^coder/build/Dockerfile$/',
      ],
      matchStrings: [
        'ARG NODE_VERSION=(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'node',
      datasourceTemplate: 'node-version',
      versioningTemplate: 'node',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^coder/build/Dockerfile$/',
      ],
      matchStrings: [
        'ARG RUST_VERSION=(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'rust',
      datasourceTemplate: 'rust-version',
      versioningTemplate: 'rust-release-channel',
    },
  ],
  packageRules: [
    {
      matchManagers: [
        'github-actions',
        'gitlabci',
        'gitlabci-include',
      ],
      automerge: true,
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      minimumReleaseAge: '1 day',
    },
    {
      matchManagers: [
        'cargo',
      ],
      automerge: true,
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      minimumReleaseAge: '1 day',
    },
    {
      matchManagers: [
        'npm',
      ],
      automerge: true,
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      minimumReleaseAge: '1 day',
    },
    {
      matchManagers: [
        'docker-compose',
        'dockerfile',
      ],
      automerge: true,
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      minimumReleaseAge: '1 day',
    },
    {
      matchManagers: [
        'npm',
      ],
      groupName: 'scalar',
      matchPackageNames: [
        '/scalar/',
      ],
    },
    {
      matchManagers: [
        'npm',
      ],
      groupName: 'regle',
      matchPackageNames: [
        '/regle/',
      ],
    },
    {
      matchManagers: [
        'npm',
      ],
      groupName: 'vueuse',
      matchPackageNames: [
        '/vueuse/',
      ],
    },
    {
      matchManagers: [
        'npm',
      ],
      groupName: 'vue-macros',
      matchPackageNames: [
        '/vue-macros/',
      ],
    },
    {
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        'vite',
        'vite-plus',
        '/^@voidzero-dev//',
      ],
      groupName: 'vite-plus',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        'vitest',
        '/^@vitest//',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'npm',
      ],
      groupName: 'codemirror',
      matchPackageNames: [
        '/^@codemirror//',
      ],
    },
    {
      matchManagers: [
        'nodenv',
        'custom.regex',
      ],
      matchDepNames: [
        'node',
      ],
      groupName: 'node-runtime',
    },
    {
      matchManagers: [
        'rust-toolchain',
        'custom.regex',
        'dockerfile',
      ],
      matchDepNames: [
        'rust',
      ],
      groupName: 'rust-toolchain',
      automerge: false,
      minimumReleaseAge: null,
    },
    {
      matchManagers: [
        'cargo',
      ],
      matchFileNames: [
        'apps/backend/crates/workspace-hack/Cargo.toml',
      ],
      enabled: false,
    },
  ],
}
