## Main System
# example: https://example.com
APP_URL="http://localhost:3000"

## Umami Analytics（使うときだけ設定する。空文字は URL / UUID の検証に通らない）
# example: https://example.com
# UMAMI_HOST=
# example: 661b12d9-a926-466d-8739-de23ee40fd5d
# UMAMI_WEBSITE_ID=

## Sentry
# Sentry DNS. Used for Error Reporting on the Server
SENTRY_DSN=
# Sentry DNS. Used for Error Reporting in the Browser
PUBLIC_ENV__SENTRY_DSN=
# Browser tracing sample rate, 0 to 1. Embedded at build time. Defaults to 0.1
# PUBLIC_ENV__SENTRY_TRACES_SAMPLE_RATE=0.1
# Browser environment name. Embedded at build time. Defaults to the build mode (production)
# PUBLIC_ENV__SENTRY_ENVIRONMENT=production
# Release name for source maps and browser events (read by sentryVitePlugin).
# Defaults to the CI commit SHA (GITHUB_SHA etc.), then the git revision
# SENTRY_RELEASE=

# Force enable Sentry in development mode
FORCE_ENABLE_IN_DEV=false

## System
# example: production
NODE_ENV=

## Build-time dev tools (opt-in, all disabled by default)
# ANALYZE=true          # Bundle analyzer (vite-bundle-analyzer)
# VITE_DEVTOOLS=true    # @vitejs/devtools (Rolldown build analysis)
# VUE_DEVTOOLS=true     # vite-plugin-vue-devtools (component inspector)
# VITE_INSPECT=true     # vite-plugin-inspect (plugin transform viewer)

## Dev server
# API_BASE=http://localhost:3400
# CODER_AGENT_URL=https://<workspace>.coder.example.com

# Sentry configuration: see server/settings/env.ts